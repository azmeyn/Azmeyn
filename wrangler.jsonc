{
  // El nombre tiene que ser igual al del proyecto en Cloudflare
  "name": "azmeyn",
  "main": "worker.js",
  "compatibility_date": "2025-09-01",
  "workers_dev": true,
  "preview_urls": false,
  // No borra las variables cargadas en el panel de Cloudflare al desplegar
  "keep_vars": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // El Worker solo se ejecuta para /api/*; lo demás se sirve directo
    "run_worker_first": ["/api/*"]
  }
}
