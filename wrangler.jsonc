{
  // El nombre tiene que ser igual al del proyecto en Cloudflare
  "name": "azmeyn",
  "main": "worker.js",
  "compatibility_date": "2025-09-01",
  "workers_dev": true,
  "preview_urls": false,
  // Dominio propio (comprado en Spaceship, DNS en Cloudflare desde el 22/11)
  "routes": [
    { "pattern": "azmeyn.com", "custom_domain": true },
    { "pattern": "www.azmeyn.com", "custom_domain": true }
  ],
  // No borra las variables cargadas en el panel de Cloudflare al desplegar
  "keep_vars": true,
"kv_namespaces": [{ "binding": "CHECKINS", "id": "f2675dba0fb3436f9eec3f18aecdd38c" }],
  // Tickets automáticos (tickets-auto.js): corre cada 5 minutos
  "triggers": { "crons": ["*/5 * * * *"] },
  // Enlace interno con el Worker del Panel stream para leer las predicciones de Twitch
  // (no se puede usar desde internet). Hay que desplegar primero panel-stream-azmeyn.
  "services": [{ "binding": "PANEL_STREAM", "service": "panel-stream-azmeyn", "entrypoint": "Predicciones" }],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // El Worker solo se ejecuta para /api/*; lo demás se sirve directo
    "run_worker_first": ["/api/*"]
  }
}
